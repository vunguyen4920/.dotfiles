{
    "mcpServers": {
        "git": {
            "args": [
                "mcp-server-git"
            ],
            "command": "uvx"
        },
        "context7": {
            "args": [
                "-y",
                "@upstash/context7-mcp@latest"
            ],
            "command": "npx"
        },
        "nuxt": {
            "command": "npx",
            "args": [
                "mcp-remote",
                "https://nuxt.com/mcp"
            ]
        }
    },
    "nativeMCPServers": []
}
